          "beacon:evidence": "decreased GPX4 activity"
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "system Xc-",
          "beacon:predicate": "supports",
          "beacon:object": "cellular antioxidant processes",
          "beacon:evidence": "role of system Xc- in cellular antioxidant processes"
        },
        {
          "@type": "beacon:Relation",
