          "beacon:evidence": "RSL3 and erastin, which inhibit the system Xc- cystine/glutamate antiporter"
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "system Xc- cystine/glutamate antiporter",
          "beacon:predicate": "leads to",
          "beacon:object": "glutathione depletion",
          "beacon:evidence": "inhibit the system Xc- cystine/glutamate antiporter, leading to glutathione depletion"
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "glutathione",
