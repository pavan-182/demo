          "beacon:predicate": "causes",
          "beacon:object": "leukocyte subset mortality",
          "beacon:evidence": "leukocyte subset mortality and subsequent loss of immunological function can result from ferroptosis"
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "ferroptosis",
          "beacon:predicate": "supports",
          "beacon:object": "the growth of parasitic or viral infections",
          "beacon:evidence": "ferroptosis in T cells brought on by lipid peroxidation encourages the growth of parasitic or viral infections"
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "ferroptosis",
          "beacon:predicate": "controls",
          "beacon:object": "how the immune system responds to dying cells",
          "beacon:evidence": "ferroptosis controls how the immune system responds to dying cells or their corpses when it affects non-leukocytic cells"
        }
