        }
      ]
    },
    {
      "@type": "schema:WebPageElement",
      "beacon:chunkId": "article-10-1016-j-ctarc-2025-100913-sec0014-p0",
      "beacon:sectionType": "other",
      "schema:text": "This subsection from the article discusses how suppressing GPX4 can induce ferroptosis as a novel strategy in cancer therapy, highlighting its role in regulating lipid peroxidation and iron-dependent oxidative stress.\n\n### Inducing Ferroptosis by suppressing GPX4 in cancer therapy\n\nFerroptosis, which is characterized by lipid peroxidation, is mostly regulated by GPX4. It inhibits ferroptosis and stops iron-dependent lipid reactive oxygen generation by catalyzing the conversion of R-OOH into R-OH. GPX4 is dependent on iron and reactive oxygen species (ROS) [ 97 ]. It is involved in the formation of the system xc−/GSH/GPX4 axis, which inhibits ferroptosis by fighting cellular phospholipid peroxidation [ 51 ]. One of the major obstacles preventing targeted anticancer therapy from producing better results in terms of stability and integrity is acquired drug resistance (Groenendijk et al., 2014).",
      "schema:name": "Mechanisms of Ferroptosis and Cancer Therapy",
      "beacon:subsectionTitle": "Inducing Ferroptosis by suppressing GPX4 in cancer therapy",
      "schema:mentions": [
        {
          "@type": "schema:Thing",
          "schema:name": "GPX4",
          "beacon:entityType": "ENTITY"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "ferroptosis",
          "beacon:entityType": "CONCEPT"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "lipid peroxidation",
          "beacon:entityType": "CONCEPT"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "iron-dependent oxidative stress",
          "beacon:entityType": "CONCEPT"
        },
        {
          "@type": "schema:Thing",
          "schema:name": "system xc−/GSH/GPX4 axis",
          "beacon:entityType": "CONCEPT"
        }
      ],
      "beacon:relations": [
        {
          "@type": "beacon:Relation",
          "beacon:subject": "GPX4",
          "beacon:predicate": "causes",
          "beacon:object": "ferroptosis",
          "beacon:evidence": "suppressing GPX4 can induce ferroptosis"
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "GPX4",
          "beacon:predicate": "regulates",
          "beacon:object": "lipid peroxidation",
          "beacon:evidence": "its role in regulating lipid peroxidation"
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "GPX4",
          "beacon:predicate": "supports",
          "beacon:object": "iron-dependent oxidative stress",
          "beacon:evidence": "stops iron-dependent lipid reactive oxygen generation"
        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "system xc−/GSH/GPX4 axis",
          "beacon:predicate": "inhibits",
          "beacon:object": "ferroptosis",
