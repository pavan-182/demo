        },
        {
          "@type": "beacon:Relation",
          "beacon:subject": "ferroptosis inducers",
          "beacon:predicate": "relates_to",
          "beacon:object": "drug resistance",
          "beacon:evidence": "overcoming drug resistance and enhancing anti-tumor immune responses in cancer therapy"
        },
        {
          "@type": "beacon:Relation",
